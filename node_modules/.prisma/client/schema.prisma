generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "dental_clinic_schema"]
}

enum AppointStatus {
  scheduled
  completed
  canceled

  @@schema("dental_clinic_schema")
}

enum InvoiceStatus {
  paid
  unpaid
  pending
  canceled

  @@schema("dental_clinic_schema")
}

enum PaymentMethod {
  cash
  credit_card
  transfer
  online

  @@schema("dental_clinic_schema")
}

enum PaymentStatus {
  success
  failed
  pending

  @@schema("dental_clinic_schema")
}

enum Role {
  ADMIN
  DOCTOR
  STAFF

  @@schema("dental_clinic_schema")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  role       String   @default("patient")
  created_at DateTime @default(now())

  @@map("users")
  @@schema("dental_clinic_schema")
}

model Patient {
  patient_id      Int       @id @default(autoincrement())
  first_name      String    @db.VarChar(50)
  last_name       String    @db.VarChar(50)
  dateofbirth     DateTime?
  address         String?
  phone           String?   @db.VarChar(10)
  chronic_disease String?
  drug_allergy    String?
  food_allergy    String?
  other_contact   String?

  appointments Appointment[]

  @@map("patients")
  @@schema("dental_clinic_schema")
}

model Appointment {
  appointment_id Int           @id @default(autoincrement())
  patient_id     Int
  appoint_date   DateTime
  appoint_time   DateTime
  appoint_status AppointStatus
  created_at     DateTime      @default(now())

  patient    Patient     @relation(fields: [patient_id], references: [patient_id])
  treatments Treatment[]
  invoices   Invoice[]

  @@map("appointment")
  @@schema("dental_clinic_schema")
}

model Dentist {
  license_number String   @id @db.VarChar(10)
  first_name     String   @db.VarChar(50)
  last_name      String   @db.VarChar(50)
  specialty      String   @db.VarChar(100)
  phone          String?  @db.VarChar(11)
  created_at     DateTime @default(now())

  @@map("dentists")
  @@schema("dental_clinic_schema")
}

model Treatment {
  treatment_id     Int      @id @default(autoincrement())
  appointment_id   Int
  treatment_date   DateTime
  treatment_detail String
  treatment_result String
  dentist_license  String   @db.VarChar(10)
  dentist_name     String   @db.VarChar(100)
  created_at       DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  invoices    Invoice[]

  @@map("treatment")
  @@schema("dental_clinic_schema")
}

model Invoice {
  invoice_id     Int           @id @default(autoincrement())
  appointment_id Int
  treatment_id   Int
  total_amount   Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus
  issue_date     DateTime
  created_at     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  treatment   Treatment   @relation(fields: [treatment_id], references: [treatment_id])
  payments    Payment[]

  @@map("invoice")
  @@schema("dental_clinic_schema")
}

model Payment {
  payment_id     Int           @id @default(autoincrement())
  invoice_id     Int
  payment_method PaymentMethod
  payment_amount Decimal       @db.Decimal(10, 2)
  payment_date   DateTime
  status         PaymentStatus

  invoice Invoice @relation(fields: [invoice_id], references: [invoice_id])

  @@map("payment")
  @@schema("dental_clinic_schema")
}

model Staff {
  staff_id   Int      @id @default(autoincrement())
  first_name String   @db.VarChar(50)
  last_name  String   @db.VarChar(50)
  phone      String?  @db.VarChar(11)
  email      String?  @unique
  created_at DateTime @default(now())

  roles         UserRole[] @relation("UserRole_Staff")
  assignedRoles UserRole[] @relation("UserRole_Assigner")

  @@map("staff")
  @@schema("dental_clinic_schema")
}

model UserRole {
  role_id     Int      @id @default(autoincrement())
  staff_id    Int
  role        Role
  assigned_by Int
  assigned_at DateTime @default(now())

  staff      Staff @relation("UserRole_Staff", fields: [staff_id], references: [staff_id])
  assignedBy Staff @relation("UserRole_Assigner", fields: [assigned_by], references: [staff_id])

  @@map("user_roles")
  @@schema("dental_clinic_schema")
}
